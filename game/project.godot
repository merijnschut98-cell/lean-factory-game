; Spanning — Godot project settings. See docs/ARCHITECTURE.md.

config_version=5

[application]

config/name="Spanning"
config/description="Lean in de netbeheer-praktijk — Voltana Netbeheer, Nova"
run/main_scene="res://src/ui/title_menu.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[debug]

gdscript/warnings/untyped_declaration=1

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[internationalization]

locale/fallback="nl"

[rendering]

environment/defaults/default_environment="res://src/world/default_environment.tres"

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
anti_aliasing/quality/msaa_3d=2
