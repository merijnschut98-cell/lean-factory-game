diff --git a/game/tests/test_office_floors.gd b/game/tests/test_office_floors.gd
index a5ef872..ad61e6a 100644
--- a/game/tests/test_office_floors.gd
+++ b/game/tests/test_office_floors.gd
@@ -112,6 +112,22 @@ func test_the_back_door_takes_the_same_player_out_and_back_in() -> void:
 	office.free()
 
 
+func test_the_vans_go_out_in_the_morning_and_come_back_in_the_afternoon() -> void:
+	var office := _office()
+	_take(office, "fix_wrong_joint")
+	office.floors.go_to("yard", "exit", true)
+	var vans := range(6).map(func(k: int) -> Node3D: return office.find_marker("van%d" % k))
+	assert_false(vans.has(null), "six vans in the model")
+	var parked := func() -> Array:
+		return range(6).filter(func(k: int) -> bool: return vans[k].visible)
+	for at: Array in [[7 * 60, [0, 1, 2, 3, 4, 5], "07:00: every bay full"],
+			[11 * 60, OfficeYard.ON_CALL, "11:00: only the storingsbussen"],
+			[17 * 60, [0, 1, 2, 3, 4, 5], "17:00: back"]]:
+		OfficeYard.park(office.geometry, at[0])
+		assert_eq(parked.call(), at[1], at[2])
+	office.free()
+
+
 func test_the_yard_is_shut_until_a_mission_needs_it() -> void:
 	var office := _office(true)   # Monday of the training week
 	office.floors.go_to("ground", "lift", true)
diff --git a/game/tests/test_office_people.gd b/game/tests/test_office_people.gd
index 09b64d7..3620102 100644
--- a/game/tests/test_office_people.gd
+++ b/game/tests/test_office_people.gd
@@ -45,6 +45,11 @@ func _office(training := false) -> Office:
 	return office
 
 
+## To floor `id` the way a player gets there: an outside area (the yard) by its door.
+func _go_to(office: Office, id: String) -> void:
+	office.floors.go_to(id, "exit" if office.floors.building.floor_of(id).get("outside_of", "") != "" else "lift", true)
+
+
 func _take(office: Office, mission_id: String) -> void:
 	office.session.missions.progress[mission_id] = {"status": "active", "asks": {}, "seen": {}}
 	office.floors._process(OfficeFloors.POLL_SECONDS)
@@ -91,6 +96,8 @@ func test_the_people_sit_at_their_desks_and_marco_walks_the_aisle() -> void:
 
 func test_henk_and_ahmed_come_only_with_their_missions() -> void:
