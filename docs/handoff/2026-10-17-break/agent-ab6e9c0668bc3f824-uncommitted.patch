+extends SceneTree
+## Scratch probe (not committed): short runs of each persona, then the report
+## from a JSON round trip (as --merge reads it).
+
+const Autoplay := preload("res://tools/autoplay.gd")
+
+
+func _initialize() -> void:
+	var args := OS.get_cmdline_user_args()
+	var runs: Array[Dictionary] = []
+	for persona: String in args[0].split(","):
+		var t := Time.get_ticks_msec()
+		var run: Dictionary = Autoplay.Persona.new(persona, int(args[1]), int(args[2])).play()
+		print("%s end %s days %.1f completed %d secs %.0f" % [persona, run["end"], run["days"], run["completed"], (Time.get_ticks_msec() - t) / 1000.0])
+		runs.append(run)
+	var parsed: Dictionary = JSON.parse_string(JSON.stringify({"runs": runs}))
+	var back: Array[Dictionary] = []
+	for r: Dictionary in parsed["runs"]:
+		r["seed"] = int(r["seed"])
+		back.append(r)
+	var catalog := Catalog.load_from()
+	var findings := Autoplay.PlayReport.findings(back, catalog)
+	var md := Autoplay.PlayReport.markdown({"generated": "probe", "seeds": [int(args[1])], "personas": [], "findings": findings, "runs": back}, catalog)
+	var f := FileAccess.open(args[3], FileAccess.WRITE)
+	f.store_string(md)
+	print("wrote ", args[3])
+	quit()
