+    show_data:
+      lands: {text: "Laat eens zien… Dat had ik niet verwacht."}
+      misses: {text: "Dus het ligt aan mijn mensen?"}
+    propose_experiment:
+      lands: {text: "Proberen kan altijd. Als het klein blijft."}
+      misses: {text: "Nu even niet."}
+    pressure:
+      lands: {text: "Aha."}
+    confront:
+      lands: {text: "Dat meen je niet."}
+    repair:
+      lands: {text: "Nee. Dat was het niet. Maar goed dat je het zegt."}
+  special:
+    repeat: "Dat vroeg je net ook."
+    refusal: "Nee. Nog niet."
+    no_proposal: "Waar moet ik precies ja op zeggen?"
+    other_data: "En?"
+    lucky_guess: "Hm. Misschien."
+    no_repair: "Herstellen? Er is niks misgegaan tussen ons."
+    patience_low: "Ik heb nog vijf minuten."
+    cooling_down: "Niet nu."
+  outcomes:
+    commitment: "Goed. Ik doe mee, en ik sta erachter."
+    partial: "Eerst zien, dan geloven."
+    heard: "Fijn dat je even luisterde."
+    none: "Goed. Tot later."
+    blocked: "Dat kan ik niet toezeggen."
+    compliance: "Als het moet, dan moet het."
+    ruined: "Ik denk dat we klaar zijn."
+    lifted: "Fijn dat je even langskwam."
