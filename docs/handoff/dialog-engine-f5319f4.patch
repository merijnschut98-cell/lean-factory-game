+# Dialogs: conversations with named people (CLAUDE.md §2, "Dialogs are give
+# and take"). Design: docs/superpowers/specs/2026-10-15-dialog-system-design.md.
+#
+# The content says WHO the person is and WHAT they would say; the rules
+# (game/src/rules/dialog.gd) decide HOW they respond to each move. No reply is
+# marked right: there is no such key. Every number here (trust, morale,
+# thresholds, patience) is an ESTIMATE chosen for play, with the reasoning in
+# the spec §3–§5.
+#
+# people:   the recurring cast (id, name, role, place = a work step,
+#           team = a pool, archetype, trust and morale 0–100, voice).
+# bank:     the shared lines: the player's line per move, the person's
+#           fallback reply per move (lands / misses), special replies, outcome
+#           texts, and the labels the UI shows (chips, bands, cue, outcomes).
+# dialogs:  one entry per conversation. kind persuade (bound to a mission) or
+#           checkin (no mission; a trigger opens it). Layers: interest, then
+#           concern (hidden until earned; its lead_in carries the cue).
+#           A concern's unlocks.clue is appended to the owned problem's clues
+#           by the build (tool conversation at the person's place, marked with
+#           the dialog so only the conversation reveals it).
+
+people:
+  - id: joost
+    name: Joost van Dijk
+    role: teamleider Werkvoorbereiding
+    place: connections.design
+    team: work_prep
+    archetype: defender
+    trust: 50
+    morale: 50   # worn down by the conflict between the departments (spec §7)
+    voice: "Mijn team haalt het doel."
+
+  - id: frank
+    name: Frank Hulshof
+    role: manager Aansluitingen & Netverzwaring
+    place: connections.design   # he walks the floor at Werkvoorbereiding; his office is the Obeya
+    team: work_prep
+    archetype: rule_bound
+    trust: 50
+    morale: 60
+    voice: "Het staat in het jaarplan."
+
+  - id: ahmed
+    name: Ahmed Bouzid
+    role: jonge monteur
+    place: outages.locate
+    team: monteurs
+    archetype: quiet
+    trust: 60   # he met the player in Henk's mission
+    morale: 42  # since Henk left (spec §8)
+    voice: "Gaat wel."
+
+bank:
+  labels:
+    bands: [Dicht, Op z'n hoede, Luistert, Open, Denkt mee]
+    cue: "Er zit meer achter…"
+    chips:
+      mood: Stemming peilen
+      open_question: Open vraag
+      reflect: Gevoel benoemen
+      empathy: Begrip tonen
+      paraphrase: Samenvatten
+      inquiry: Doorvragen
+      experience: Ervaring delen
+      silence: Stilte laten
+      perspective: Ander perspectief
+      show_data: Data laten zien
+      propose_experiment: Experiment voorstellen
+      propose: Voorstel doen
+      ask_commitment: Afspraak maken
+      pressure: Druk zetten
+      confront: Aanspreken
+      repair: Terugkomen op vorige keer
+      close: Afronden
+    outcomes:
+      commitment: Staat erachter
+      partial: Afspraak onder voorwaarde
+      heard: Gehoord
+      none: Geen uitkomst
+      blocked: Geblokkeerd
+      compliance: Gaat akkoord onder druk
+      ruined: Mislukt
+      lifted: Opgebeurd
+  player:
+    mood: "Hoe gaat het vandaag, echt?"
+    open_question: "Hoe ziet jouw week eruit?"
+    reflect: "Het klinkt alsof je klem zit."
+    empathy: "Dat is ook niet niks, als je zo je best doet."
+    paraphrase: "Even kijken of ik je goed begrijp. Wat je zegt, is…"
+    inquiry: "Wat maakt dat het zo is?"
+    experience: "Toen ik net begon, had ik precies dat."
+    silence: "(je zegt niets en wacht)"
+    perspective: "Hoe zou de monteur dit zien, denk je?"
+    show_data: "Kijk eens naar deze cijfers."
+    propose_experiment: "Zullen we het eerst klein proberen?"
+    propose: "Ik heb een voorstel."
+    ask_commitment: "Spreken we dit af?"
+    pressure: "Het MT wil dat dit verandert. Liever met jou dan zonder jou."
+    confront: "Dit ligt toch gewoon aan jouw team?"
+    repair: "Vorige keer begon ik met mijn verhaal in plaats van met het jouwe. Dat was niet handig."
+    close: "Dank je voor je tijd."
+  replies:
